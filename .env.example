ENVIRONMENT=production
LOG_LEVEL=INFO
BOT_TOKEN=replace-with-token-from-botfather
ADMIN_IDS=123456789
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=autocheck
POSTGRES_USER=autocheck
POSTGRES_PASSWORD=replace-with-strong-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
PAYMENTS_ENABLED=false
FREE_PLATE_SEARCH=true
FREE_VIN_SEARCH=true
FREE_HISTORY=true
FREE_INSURANCE_SEARCH=true
PDF_REPORTS_ENABLED=false
EXTERNAL_PAID_DATA_ENABLED=false
INSURANCE_PROVIDER=mock
RATE_LIMIT_PER_MINUTE=10
DAILY_SEARCH_LIMIT=100
DUPLICATE_QUERY_LIMIT=5
SUSPICIOUS_BLOCK_SECONDS=900
VEHICLE_CACHE_TTL=86400
INSURANCE_CACHE_TTL=3600
FAST_RESALE_DAYS=30
FREQUENT_OWNER_CHANGE_MONTHS=24
FREQUENT_OWNER_CHANGE_COUNT=3
FREQUENT_PLATE_CHANGE_COUNT=3
HISTORY_COVERAGE_START_YEAR=2013
QUERY_HASH_SALT=replace-with-long-random-value
DATASET_DEFAULT_URL=
AUTO_RIA_ENABLED=false
AUTO_RIA_API_KEY=
AUTO_RIA_BASE_URL=https://developers.ria.com
AUTO_RIA_CACHE_TTL=21600
MARKETPLACE_PROVIDER=disabled
MARKETPLACE_REFRESH_HOURS=12
AUCTION_HISTORY_ENABLED=false
AUCTION_PROVIDER=mock
AUCTION_API_KEY=
AUCTION_API_BASE_URL=
AUCTION_CACHE_TTL=2592000
FREE_AUCTION_HISTORY=true
FREE_AUCTION_PHOTOS=true
FREE_MARKETPLACE_HISTORY=true
FREE_ODOMETER_HISTORY=true
FREE_FULL_REPORT=true
FREE_FULL_TIMELINE=true
FREE_HISTORY_SCORE=true
ODOMETER_ROLLBACK_TOLERANCE_KM=1000
EXTERNAL_PROVIDER_TIMEOUT_SECONDS=10
EXTERNAL_PROVIDER_DAILY_LIMIT=1000
HISTORY_SCORE_ENABLED=true
HISTORY_SCORE_AUCTION_PENALTY=8
HISTORY_SCORE_DAMAGE_PENALTY=12
HISTORY_SCORE_ODOMETER_LOW_PENALTY=5
HISTORY_SCORE_ODOMETER_MEDIUM_PENALTY=12
HISTORY_SCORE_ODOMETER_HIGH_PENALTY=25
